{
  "title": "RAG Dashboard",
  "uid": "rag-dashboard",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Retrieval Latency",
      "targets": [{ "expr": "ai_vector_search_duration" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Similarity Score",
      "targets": [{ "expr": "ai_rag_similarity_score" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Documents Retrieved",
      "targets": [{ "expr": "ai_rag_documents_retrieved" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    }
  ]
}
