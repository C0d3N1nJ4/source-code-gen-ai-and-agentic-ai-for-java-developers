{
  "title": "AI Overview",
  "uid": "ai-overview",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Requests/sec",
      "targets": [{ "expr": "rate(http_server_requests_seconds_count[1m])" }],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Response Time",
      "targets": [{ "expr": "ai_response_latency" }],
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Token Usage",
      "targets": [{ "expr": "ai_tokens_total" }],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Estimated Cost",
      "targets": [{ "expr": "ai_tokens_total * 0.0000017" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    }
  ]
}
